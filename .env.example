# ============================================================
# VLM API 配置模板
# ============================================================
# 【用法】把本文件复制成 .env（去掉 .example），填入你的 key：
#     cp .env.example .env
# 脚本会自动读取，不用每次重设环境变量。
#
# ⚠️ .env 里有密钥，不要上传到 GitHub
# ============================================================

# ────────────────────────────────────────────────────────────
# 方案 A ⭐ 智谱 AI（推荐：glm-4v-flash 永久免费、国内直连）
# 注册：https://open.bigmodel.cn/
# ────────────────────────────────────────────────────────────
VLM_PROVIDER=zhipu
VLM_API_KEY=在这里填你的智谱key

# ────────────────────────────────────────────────────────────
# 方案 B 硅基流动（9B 以下模型永久免费、国内直连）
# 注册：https://siliconflow.cn/
# 切换到本方案：把上面 VLM_PROVIDER 改成 siliconflow 即可
# ────────────────────────────────────────────────────────────
# VLM_PROVIDER=siliconflow
# VLM_API_KEY=在这里填你的硅基流动key

# ────────────────────────────────────────────────────────────
# 方案 C 阿里云百炼（新用户免费额度，3 个月有效）
# 注册：https://bailian.console.aliyun.com/
# ────────────────────────────────────────────────────────────
# VLM_PROVIDER=dashscope
# VLM_API_KEY=在这里填你的百炼key


# ============================================================
# 以下留空即可 —— 脚本会按 VLM_PROVIDER 自动填默认值
# 只有需要覆盖时才取消注释
# ============================================================

# VLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# VLM_MODEL=glm-4v-flash

# ---- 其他开关 ----
# USE_VLM=1                 # 启动 app.py 时是否默认开启 VLM 复核
